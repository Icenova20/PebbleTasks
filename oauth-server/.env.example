# Copy to .env — values are loaded on startup via dotenv (see server.js).
# Optional: for docker-compose, map the Pi host port (container always listens on 3847)
# HOST_PORT=3847
PORT=3847
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
BASE_PUBLIC_URL=http://localhost:3847
